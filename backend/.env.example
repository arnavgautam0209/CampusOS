# Copy to .env (never commit .env) and export before running, e.g.:
#   set -a; source .env; set +a
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
# Add your Mac's LAN IP so an iPhone or ESP32 on the same Wi-Fi can connect.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata
# Optional fixed password for `seed_demo --demo-user`; otherwise one is generated.
CAMPUSOS_DEMO_PASSWORD=
